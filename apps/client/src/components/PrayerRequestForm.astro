---
import { useTranslations } from "@i18n/utils";
import type { Locale } from "@i18n";

type Props = {
  idPrefix: string;
  lang: Locale;
  compact?: boolean;
};

const { idPrefix, lang, compact = false } = Astro.props;
const t = useTranslations(lang);
const pomelnicWorkerUrl = import.meta.env.PUBLIC_POMELNIC_WORKER_URL;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const formAction = pomelnicWorkerUrl
  ? pomelnicWorkerUrl.startsWith("http")
    ? pomelnicWorkerUrl
    : `https://${pomelnicWorkerUrl}`
  : "#";
const redirectUrl = `${Astro.url.origin}${Astro.url.pathname}#pomelnic-form`;

const inputClass =
  "mt-2 w-full rounded-md border border-neutral-200 bg-white px-4 py-3 text-base text-neutral-900 shadow-sm outline-none transition focus:border-church-green focus:ring-4 focus:ring-church-green/15";
const labelClass = "block text-sm font-bold text-neutral-800";
const textareaClass = `${inputClass} max-h-[280px] min-h-[150px] resize-y`;
---

<form class={compact ? "grid gap-4" : "grid gap-5"} action={formAction} method="post">
  <input type="hidden" name="redirect" value={redirectUrl} />
  <input type="hidden" name="language" value={lang} />
  <input class="hidden" type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" />

  <p
    class="hidden rounded-md border px-4 py-3 text-sm font-semibold data-[status=error]:border-[#fecdca] data-[status=error]:bg-[#fffbfa] data-[status=error]:text-[#b42318] data-[status=success]:border-[#abefc6] data-[status=success]:bg-[#f6fef9] data-[status=success]:text-[#027a48]"
    data-pomelnic-status
    id={`${idPrefix}-status`}
    role="status"
    aria-live="polite"
    data-success={t("pomelnic.success")}
    data-challenge="Verificarea anti-spam nu a fost finalizată. Te rugăm să bifezi verificarea și să trimiți din nou."
    data-send="Formularul a ajuns la server, dar e-mailul nu a putut fi trimis."
    data-invalid="Formularul trimis nu este valid. Te rugăm să reîncerci."
    data-error={t("pomelnic.error")}>
  </p>

  <div class={compact ? "grid gap-4" : "grid gap-5 md:grid-cols-2"}>
    <label class={labelClass} for={`${idPrefix}-name`}>
      {t("pomelnic.name")}
      <span class="text-[#b42318]">*</span>
      {!compact && <span class="block pt-1 text-xs font-normal text-neutral-500">{t("pomelnic.nameHelp")}</span>}
      <input class={inputClass} id={`${idPrefix}-name`} name="name" type="text" autocomplete="name" required />
    </label>

    <label class={labelClass} for={`${idPrefix}-email`}>
      {t("pomelnic.email")}
      <span class="text-[#b42318]">*</span>
      <span class="block pt-1 text-xs font-normal text-neutral-500">{t("pomelnic.emailHelp")}</span>
      <input class={inputClass} id={`${idPrefix}-email`} name="email" type="email" autocomplete="email" required />
    </label>
  </div>

  <div class={compact ? "grid gap-4" : "grid gap-5 md:grid-cols-2"}>
    <label class={labelClass} for={`${idPrefix}-living`}>
      {t("pomelnic.living")}
      <textarea
        class={textareaClass}
        id={`${idPrefix}-living`}
        name="living_names"
        placeholder={t("pomelnic.livingPlaceholder")}></textarea>
    </label>

    <label class={labelClass} for={`${idPrefix}-departed`}>
      {t("pomelnic.departed")}
      <textarea
        class={textareaClass}
        id={`${idPrefix}-departed`}
        name="departed_names"
        placeholder={t("pomelnic.departedPlaceholder")}></textarea>
    </label>
  </div>

  <label class={labelClass} for={`${idPrefix}-message`}>
    {t("pomelnic.message")}
    <textarea
      class={`${textareaClass} min-h-[130px]`}
      id={`${idPrefix}-message`}
      name="message"
      placeholder={t("pomelnic.messagePlaceholder")}></textarea>
  </label>

  {
    turnstileSiteKey && (
      <div
        class="cf-turnstile min-h-[65px]"
        data-sitekey={turnstileSiteKey}
        data-theme="light"
        data-size={compact ? "compact" : "normal"}
      />
    )
  }

  <div class="flex flex-wrap items-center justify-between gap-4 pt-1">
    <p class="m-0 max-w-[520px] text-sm leading-6 text-neutral-500">
      {t("pomelnic.requiredHelp")}
    </p>
    <button
      class="bg-church-green focus:ring-church-green/20 inline-flex min-h-12 cursor-pointer items-center justify-center rounded-md px-7 font-bold text-white shadow-[0_12px_24px_rgb(8_115_61_/_22%)] transition hover:bg-[#065f32] focus:ring-4 focus:outline-none"
      type="submit">
      {t("pomelnic.submit")}
    </button>
  </div>
</form>

{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />}

<script is:inline>
  (() => {
    const status = new URLSearchParams(window.location.search).get("pomelnic");
    if (status) {
      document.querySelectorAll("[data-pomelnic-status]").forEach((element) => {
        const isSuccess = status === "ok";
        element.textContent = isSuccess ? element.dataset.success : element.dataset[status] || element.dataset.error;
        element.dataset.status = isSuccess ? "success" : "error";
        element.classList.remove("hidden");
      });
    }
  })();
</script>
