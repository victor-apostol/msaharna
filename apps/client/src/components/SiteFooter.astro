---
import type { Locale } from "@i18n";
import { getLocalizedPath, useTranslations } from "@i18n/utils";

type Props = {
  lang: Locale;
};

const { lang } = Astro.props;
const t = useTranslations(lang);
const homePath = getLocalizedPath("/", lang);
const homeAnchor = (id: string) => `${homePath}#${id}`;
const footerLinks = [
  { key: "nav.presentation", href: homeAnchor("prezentare") },
  { key: "nav.directions", href: homeAnchor("cum-de-ajuns") },
  { key: "nav.serviceSchedule", href: homeAnchor("programul-slujbelor") },
  { key: "nav.pomelnic", href: "#pomelnic-modal" },
  { key: "nav.contact", href: getLocalizedPath("/contact", lang) },
  { key: "nav.donations", href: getLocalizedPath("/donations", lang) },
] as const;
---

<footer class="bg-church-green border-sacred-gold/70 text-parchment/80 border-t-4 px-5 py-10">
  <div class="mx-auto w-[min(1200px,calc(100%_-_20px))]">
    <div class="mb-8">
      <p class="text-parchment font-serif text-lg font-bold uppercase">{t("main.title")}</p>
      <p class="mt-2 text-sm italic">{t("footer.description")}</p>
    </div>
    <nav class="mb-8 grid grid-cols-6 gap-5 text-sm max-lg:grid-cols-2 max-sm:grid-cols-1" aria-label={t("nav.menu")}>
      {
        footerLinks.map((item) => (
          <a class="hover:text-sacred-gold" href={item.href}>
            {t(item.key)}
          </a>
        ))
      }
    </nav>
    <div class="border-t border-white/20 pt-5 text-center text-sm">
      {t("footer.copyright")}
    </div>
  </div>
</footer>
