---
import type { Locale } from "@i18n";
import { getLocalizedPath, useTranslations } from "@i18n/utils";

type Props = {
  lang: Locale;
};

const { lang } = Astro.props;
const t = useTranslations(lang);
const homePath = getLocalizedPath("/", lang);
const homeAnchor = (id: string) => `${homePath}#${id}`;
const footerLinks = [
  { key: "nav.presentation", href: homeAnchor("prezentare") },
  { key: "nav.directions", href: homeAnchor("cum-de-ajuns") },
  { key: "nav.serviceSchedule", href: homeAnchor("programul-slujbelor") },
  { key: "nav.pomelnic", href: "#pomelnic-modal" },
  { key: "nav.contact", href: getLocalizedPath("/contact", lang) },
  { key: "nav.donations", href: getLocalizedPath("/donations", lang) },
] as const;
const socialLinks = [
  { key: "social.youtube", href: "https://www.youtube.com/@manastirea.saharna", icon: "youtube", mark: "" },
  { key: "social.facebook", href: "https://www.facebook.com/ManastireaSaharna/", icon: "text", mark: "f" },
  { key: "social.tiktok", href: "https://www.tiktok.com/@monklife?_r=1&_t=ZS-972uTnfFdwq", icon: "tiktok", mark: "" },
] as const;
---

<footer class="bg-church-green border-sacred-gold/70 text-parchment/80 border-t-4 px-5 py-10">
  <div class="mx-auto w-[min(1200px,calc(100%_-_20px))]">
    <div class="mb-8">
      <p class="text-parchment font-serif text-lg font-bold uppercase">{t("main.title")}</p>
      <!-- <p class="mt-2 text-sm italic">{t("footer.description")}</p> -->
    </div>
    <nav class="mb-8 grid grid-cols-6 gap-5 text-sm max-lg:grid-cols-2 max-sm:grid-cols-1" aria-label={t("nav.menu")}>
      {
        footerLinks.map((item) => (
          <a class="hover:text-sacred-gold" href={item.href}>
            {t(item.key)}
          </a>
        ))
      }
    </nav>
    <div class="border-t border-white/20 pt-5 text-sm">
      <div class="flex items-center justify-between gap-4 max-sm:flex-col max-sm:items-center max-sm:text-center">
        <p class="m-0">{t("footer.copyright")}</p>
        <nav class="ml-auto flex shrink-0 items-center justify-end gap-2 max-sm:ml-0" aria-label={t("social.label")}>
          {
            socialLinks.map((item) => (
              <a
                class="border-parchment/30 text-parchment/85 hover:border-sacred-gold hover:bg-sacred-gold hover:text-ink inline-flex h-7 w-7 items-center justify-center rounded-full border text-xs font-bold no-underline transition"
                href={item.href}
                aria-label={t(item.key)}
                title={t(item.key)}
                target="_blank"
                rel="noreferrer">
                {
                  item.icon === "youtube" ? (
                    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4L15.8 12l-6.2 3.6Z" />
                    </svg>
                  ) : item.icon === "tiktok" ? (
                    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M16.6 2c.3 2.6 1.8 4.2 4.3 4.4v3.1a7.6 7.6 0 0 1-4.3-1.3v7.6c0 3.9-2.6 6.2-6.1 6.2-3.6 0-6.4-2.7-6.4-6.1 0-3.7 3.1-6.5 7-6.1v3.2c-2-.3-3.7.9-3.7 2.8 0 1.7 1.4 3 3.1 3 1.8 0 2.8-1.1 2.8-3.3V2h3.3Z" />
                    </svg>
                  ) : (
                    <span aria-hidden="true">{item.mark}</span>
                  )
                }
              </a>
            ))
          }
        </nav>
      </div>
    </div>
  </div>
</footer>
