---
import type { Locale } from "@i18n";
import AboutSection from "./figma/AboutSection.astro";
import GallerySection from "./figma/GallerySection.astro";
import HeroSection from "./figma/HeroSection.astro";
import NewsPreviewSection from "./figma/NewsPreviewSection.astro";
import PomelnicSection from "./PomelnicSection.astro";
import ServiceTicker from "./figma/ServiceTicker.astro";
import VisitCta from "./figma/VisitCta.astro";
import VisitInfoSection from "./figma/VisitInfoSection.astro";

type Props = {
  lang: Locale;
};

const { lang } = Astro.props;
---

<section class="bg-parchment text-ink">
  <HeroSection lang={lang} />
  <ServiceTicker lang={lang} />
  <AboutSection lang={lang} />
  <NewsPreviewSection lang={lang} />
  <GallerySection lang={lang} />
  <VisitCta lang={lang} />
  <PomelnicSection lang={lang} />
  <VisitInfoSection lang={lang} />
</section>
