---
import PrayerRequestForm from "@components/PrayerRequestForm.astro";
import type { Locale } from "@i18n";
import { useTranslations } from "@i18n/utils";

type Props = {
  lang: Locale;
};

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="pomelnic-form" class="bg-parchment py-16 max-sm:py-12" aria-labelledby="pomelnic-title">
  <div
    class="mx-auto grid w-[min(1200px,calc(100%_-_40px))] grid-cols-[minmax(0,0.78fr)_minmax(420px,1.22fr)] gap-10 max-lg:grid-cols-1 max-md:w-[calc(100%_-_32px)]">
    <div>
      <span class="bg-sacred-gold mb-8 block h-0.5 w-[70px]"></span>
      <p class="text-sacred-gold m-0 font-sans text-xs uppercase">{t("pomelnic.eyebrow")}</p>
      <h2
        id="pomelnic-title"
        class="text-ink mt-4 mb-5 max-w-[520px] font-serif text-[clamp(34px,4vw,52px)] leading-[1.08] font-bold uppercase">
        {t("pomelnic.title")}
      </h2>
      <p class="text-muted-brown m-0 max-w-[560px] text-[17px] leading-8">
        {t("pomelnic.description")}
      </p>
    </div>
    <div class="border-sacred-gold rounded-sm border-t-4 bg-white p-6 shadow-[0_18px_55px_rgb(0_0_0_/_10%)] md:p-8">
      <PrayerRequestForm idPrefix="page-pomelnic" lang={lang} />
    </div>
  </div>
</section>
