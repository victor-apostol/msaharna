---
import { publicAsset } from "@utils/paths";

const galleryItems = [
  { label: "Biserica principală", image: publicAsset("/images/history-header.png") },
  { label: "Curtea mănăstirii", image: publicAsset("/images/representation-first.jpg") },
  { label: "Crucea de pe cupolă", image: publicAsset("/images/representation-middle.jpg") },
  { label: "Schitul rupestru", image: publicAsset("/images/representation-third.jpg") },
] as const;
---

<section id="galerie" class="bg-parchment-line py-14">
  <div class="mx-auto w-[min(1200px,calc(100%_-_40px))] max-md:w-[calc(100%_-_32px)]">
    <div class="mb-8 flex items-end justify-between gap-6 max-sm:block">
      <div>
        <p class="text-sacred-gold mb-3 font-sans text-xs uppercase">Galerie foto</p>
        <h2 class="font-serif text-[36px] leading-tight font-bold uppercase max-sm:text-[28px]">
          Frumusețea locului sfânt
        </h2>
        <div class="bg-sacred-gold mt-4 h-0.5 w-16"></div>
      </div>
      <a class="text-church-green hover:text-ink text-base italic max-sm:mt-5 max-sm:inline-flex" href="#galerie"
        >Vezi toată galeria -&gt;</a
      >
    </div>
    <div class="grid grid-cols-[1.35fr_0.9fr_0.9fr_1.35fr] gap-3 max-lg:grid-cols-2 max-sm:grid-cols-1">
      {
        galleryItems.map((item) => (
          <figure class="group bg-muted-brown relative overflow-hidden rounded-sm">
            <img
              class="h-60 w-full object-cover opacity-75 transition group-hover:scale-[1.03] group-hover:opacity-90"
              src={item.image}
              alt={item.label}
              loading="lazy"
            />
            <figcaption class="text-parchment absolute right-3 bottom-3 left-3 text-sm italic drop-shadow">
              {item.label}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
