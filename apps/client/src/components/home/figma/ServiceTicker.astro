---
import type { Locale } from "@i18n";
import { useTranslations } from "@i18n/utils";

type Props = {
  lang: Locale;
};

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="programul-slujbelor" class="border-sacred-gold bg-church-green border-y-2 px-4 py-4 text-center">
  <p class="text-parchment text-[22px] leading-7 max-sm:text-lg">
    {t("home.figmaServiceSchedule")}
  </p>
  <a class="text-sacred-gold hover:text-parchment mt-1 inline-flex text-sm italic" href="#calendar-liturgic"
    >{t("home.figmaServiceLink")} -&gt;</a
  >
</section>
