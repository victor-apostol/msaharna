---
import { Clock, Mail, MapPin, Phone } from "lucide-astro";

import type { Locale } from "@i18n";
import { useTranslations } from "@i18n/utils";

type Props = {
  lang: Locale;
};

const { lang } = Astro.props;
const t = useTranslations(lang);
const iconClass = "h-5 w-5";
const mapQuery = "Manastirea Saharna Rezina Moldova";
const mapEmbedUrl = `https://www.google.com/maps?q=${encodeURIComponent(mapQuery)}&output=embed`;
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapQuery)}`;
const contactItems = [
  {
    label: t("footer.addressTitle"),
    value: `${t("footer.addressName")}, ${t("footer.addressLine")}`,
    href: mapUrl,
    icon: MapPin,
  },
  {
    label: t("footer.phoneLabel"),
    value: t("footer.phone"),
    href: `tel:${t("footer.phone").replace(/\s/g, "")}`,
    icon: Phone,
  },
  {
    label: t("footer.emailLabel"),
    value: t("footer.email"),
    href: `mailto:${t("footer.email").split(",")[0]}`,
    icon: Mail,
  },
  { label: t("home.visitHoursLabel"), value: t("home.visitHours"), href: undefined, icon: Clock },
] as const;
const weekdays = ["Lun", "Mar", "Mie", "Joi", "Vin", "Sâm", "Dum"] as const;
const calendarCells = [
  ...Array.from({ length: 3 }, () => null),
  ...Array.from({ length: 31 }, (_, index) => index + 1),
];
---

<section id="cum-de-ajuns" class="grid grid-cols-[minmax(0,620px)_minmax(0,1fr)] max-lg:grid-cols-1">
  <div
    id="calendar-liturgic"
    class="bg-parchment px-[max(32px,calc((100vw-1200px)/2))] py-14 lg:pr-20 lg:pl-[max(32px,calc((100vw-1200px)/2))]">
    <p class="text-sacred-gold mb-3 font-sans text-xs uppercase">Calendar liturgic</p>
    <h2 class="mb-5 font-serif text-[34px] leading-none font-bold uppercase">Mai 2025</h2>
    <div class="border-parchment-line max-w-[380px] border-t pt-4">
      <div class="text-muted-brown mb-4 grid grid-cols-7 gap-y-3 font-sans text-xs">
        {weekdays.map((day, index) => <span class={index === 6 ? "text-sacred-gold" : ""}>{day}</span>)}
      </div>
      <div class="grid grid-cols-7 gap-y-4 text-sm">
        {
          calendarCells.map((day, index) =>
            day ? (
              <span
                class:list={[
                  "grid h-7 w-7 place-items-center rounded-full",
                  index % 7 === 6 && "text-sacred-gold",
                  day === 30 && "bg-sacred-gold text-parchment",
                ]}>
                {day}
              </span>
            ) : (
              <span aria-hidden="true" />
            ),
          )
        }
      </div>
    </div>
  </div>

  <div
    id="contacte"
    class="bg-parchment-deep px-[max(32px,calc((100vw-1200px)/2))] py-14 lg:pr-[max(32px,calc((100vw-1200px)/2))] lg:pl-24">
    <p class="text-sacred-gold mb-3 font-sans text-xs uppercase">{t("nav.contact")}</p>
    <h2 class="mb-4 font-serif text-[34px] leading-none font-bold uppercase">{t("home.findUsTitle")}</h2>
    <div class="bg-sacred-gold mb-7 h-0.5 w-[70px]"></div>
    <div class="grid max-w-[580px] gap-6">
      {
        contactItems.map((item) => {
          const Icon = item.icon;
          const ValueTag = item.href ? "a" : "span";

          return (
            <div class="grid grid-cols-[38px_1fr] gap-4">
              <span
                class="bg-sacred-gold text-ink grid h-[38px] w-[38px] place-items-center rounded-full"
                aria-hidden="true">
                <Icon class={iconClass} stroke-width={2.2} />
              </span>
              <p>
                <span class="text-muted-brown block font-sans text-xs uppercase">{item.label}</span>
                <ValueTag
                  class:list={[
                    "block text-[17px] leading-6",
                    item.href && "hover:text-church-green underline-offset-4 hover:underline",
                  ]}
                  href={item.href}>
                  {item.value}
                </ValueTag>
              </p>
            </div>
          );
        })
      }
      <div class="border-sacred-gold bg-parchment mt-1 overflow-hidden rounded-sm border-t-4">
        <iframe
          class="h-[260px] w-full"
          title={t("home.mapTitle")}
          src={mapEmbedUrl}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
        <a
          class="text-church-green hover:bg-parchment-deep flex min-h-12 items-center justify-center px-5 text-center font-sans text-sm font-bold uppercase no-underline transition"
          href={mapUrl}
          target="_blank"
          rel="noreferrer">
          {t("home.openMap")}
        </a>
      </div>
    </div>
  </div>
</section>
