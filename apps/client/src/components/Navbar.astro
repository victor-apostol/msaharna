---
import type { Locale } from "@i18n";
import { getLocalizedPath, useTranslations } from "@i18n/utils";
import { stripBasePath } from "@utils/paths";

import logoUrl from "../../../../Logo_preview_big.png?url";

type Props = {
  path: string;
  lang: Locale;
};

const { path, lang } = Astro.props;
const t = useTranslations(lang);
const normalizedPath =
  stripBasePath(path)
    .replace(/\.html$/, "")
    .replace(/\/$/, "") || "/";
const isHome = normalizedPath === "/" || normalizedPath === `/${lang}`;
const donationsPath = getLocalizedPath("/donations", lang);
const isDonations = normalizedPath === "/donations" || normalizedPath === `/${lang}/donations`;
const homePath = getLocalizedPath("/", lang);
const homeAnchor = (id: string) => `${homePath}#${id}`;
const navItems = [
  { key: "nav.presentation", href: homeAnchor("prezentare"), active: isHome },
  { key: "nav.directions", href: homeAnchor("cum-de-ajuns"), active: false },
  { key: "nav.serviceSchedule", href: homeAnchor("programul-slujbelor"), active: false },
  { key: "nav.contact", href: homeAnchor("contacte"), active: false },
  { key: "nav.donations", href: donationsPath, active: isDonations },
] as const;
const languageItems = [
  { locale: "ro", label: "RO" },
  { locale: "ru", label: "RU" },
] as const;
---

<header class="bg-parchment border-parchment-line sticky top-0 z-50 border-b">
  <input id="primary-menu-toggle" class="peer sr-only" type="checkbox" aria-hidden="true" />
  <div
    class="mx-auto grid h-20 w-[min(1200px,calc(100%_-_40px))] grid-cols-[auto_1fr_auto] items-center gap-6 max-lg:w-[calc(100%_-_32px)] max-lg:grid-cols-[auto_1fr_auto] max-sm:h-[68px] peer-checked:[&_.burger-bottom]:top-[7px] peer-checked:[&_.burger-bottom]:-rotate-45 peer-checked:[&_.burger-middle]:opacity-0 peer-checked:[&_.burger-top]:top-[7px] peer-checked:[&_.burger-top]:rotate-45">
    <a
      class="text-ink flex min-w-0 items-center gap-3 no-underline"
      href={getLocalizedPath("/", lang)}
      aria-label={t("main.title")}>
      <span
        class="border-sacred-gold/70 bg-parchment-line grid h-12 w-12 shrink-0 place-items-center overflow-hidden rounded-full border max-sm:h-10 max-sm:w-10">
        <img class="h-full w-full object-cover object-center mix-blend-multiply" src={logoUrl} alt="" />
      </span>
      <span class="font-serif text-xl leading-none font-bold uppercase max-sm:text-base">Saharna</span>
    </a>

    <nav
      class="text-ink flex items-center justify-center gap-10 text-[15px] leading-none max-xl:gap-6 max-lg:hidden"
      aria-label={t("nav.menu")}>
      {
        navItems.map((item) => (
          <a
            class={`hover:text-church-green whitespace-nowrap underline-offset-8 transition hover:underline ${
              item.active ? "text-church-green underline" : ""
            }`}
            href={item.href}
            aria-current={item.active ? "page" : undefined}>
            {t(item.key)}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center justify-end gap-5">
      <nav
        class="text-muted-brown hidden items-center gap-2 font-sans text-xs sm:flex"
        aria-label={t("language.label")}>
        {
          languageItems.map((item, index) => (
            <>
              <a
                class="hover:text-ink"
                href={getLocalizedPath(path, item.locale)}
                aria-label={t(`language.${item.locale}`)}>
                {item.label}
              </a>
              {index < languageItems.length - 1 && <span aria-hidden="true">|</span>}
            </>
          ))
        }
      </nav>

      <label
        for="primary-menu-toggle"
        class="text-ink border-parchment-line bg-parchment hover:bg-parchment-deep hidden h-11 w-11 cursor-pointer list-none items-center justify-center rounded-sm border transition marker:hidden max-lg:inline-flex [&::-webkit-details-marker]:hidden"
        aria-label={t("nav.openMenu")}
        aria-controls="primary-menu">
        <span class="sr-only">{t("nav.menu")}</span>
        <span class="relative block h-4 w-5" aria-hidden="true">
          <span class="burger-top absolute top-0 left-0 h-0.5 w-5 bg-current transition"></span>
          <span class="burger-middle absolute top-[7px] left-0 h-0.5 w-5 bg-current transition"></span>
          <span class="burger-bottom absolute top-3.5 left-0 h-0.5 w-5 bg-current transition"></span>
        </span>
      </label>
    </div>
  </div>

  <nav
    id="primary-menu"
    class="bg-parchment border-parchment-line hidden border-t peer-checked:block lg:hidden"
    aria-label={t("nav.menu")}>
    <div class="text-ink mx-auto grid w-[calc(100%_-_32px)] gap-1 py-4 text-base">
      {
        navItems.map((item) => (
          <a
            class={`rounded-sm px-3 py-3 transition ${item.active ? "bg-parchment-deep text-church-green" : "hover:bg-parchment-deep"}`}
            href={item.href}
            aria-current={item.active ? "page" : undefined}>
            {t(item.key)}
          </a>
        ))
      }
      <div class="border-parchment-line text-muted-brown mt-2 flex gap-3 border-t pt-4 font-sans text-sm sm:hidden">
        {
          languageItems.map((item) => (
            <a
              class="hover:text-ink"
              href={getLocalizedPath(path, item.locale)}
              aria-label={t(`language.${item.locale}`)}>
              {item.label}
            </a>
          ))
        }
      </div>
    </div>
  </nav>
</header>
