---
import type { Locale } from "@i18n";
import { getLocalizedPath, useTranslations } from "@i18n/utils";
import { stripBasePath } from "@utils/paths";

import logoUrl from "../../../../Logo_preview_big.png?url";

type Props = {
  path: string;
  lang: Locale;
};

const { path, lang } = Astro.props;
const t = useTranslations(lang);
const normalizedPath =
  stripBasePath(path)
    .replace(/\.html$/, "")
    .replace(/\/$/, "") || "/";
const isHome = normalizedPath === "/" || normalizedPath === `/${lang}`;
const donationsPath = getLocalizedPath("/donations", lang);
const isDonations = normalizedPath === "/donations" || normalizedPath === `/${lang}/donations`;
const contactPath = getLocalizedPath("/contact", lang);
const isContact = normalizedPath === "/contact" || normalizedPath === `/${lang}/contact`;
const homePath = getLocalizedPath("/", lang);
const homeAnchor = (id: string) => `${homePath}#${id}`;
const navItems = [
  { key: "nav.presentation", href: homeAnchor("prezentare"), active: isHome },
  { key: "nav.directions", href: homeAnchor("cum-de-ajuns"), active: false },
  { key: "nav.serviceSchedule", href: homeAnchor("programul-slujbelor"), active: false },
  { key: "nav.pomelnic", href: "#pomelnic-modal", active: false },
  { key: "nav.contact", href: contactPath, active: isContact },
  { key: "nav.donations", href: donationsPath, active: isDonations },
] as const;
const languageItems = [
  { locale: "ro", label: "RO" },
  { locale: "en", label: "EN" },
  { locale: "ru", label: "RU" },
] as const;
---

<header class="bg-church-green border-sacred-gold/70 sticky top-0 z-50 border-b">
  <input id="primary-menu-toggle" class="peer sr-only" type="checkbox" aria-hidden="true" />
  <div
    class="mx-auto grid h-20 w-[min(1200px,calc(100%_-_40px))] grid-cols-[auto_1fr_auto] items-center gap-6 max-lg:w-full max-lg:grid-cols-[auto_1fr_auto] max-lg:pr-0 max-lg:pl-4 max-sm:h-[68px] peer-checked:[&_.burger-bottom]:top-[7px] peer-checked:[&_.burger-bottom]:-rotate-45 peer-checked:[&_.burger-middle]:opacity-0 peer-checked:[&_.burger-top]:top-[7px] peer-checked:[&_.burger-top]:rotate-45">
    <a
      class="text-parchment flex min-w-0 items-center gap-2.5 no-underline"
      href={getLocalizedPath("/", lang)}
      aria-label={t("main.title")}>
      <span
        class="grid h-11 w-11 shrink-0 place-items-center overflow-hidden rounded-full border-2 border-white/85 bg-white p-0.5 shadow-[0_0_0_1px_rgb(255_255_255_/_18%)] max-sm:h-10 max-sm:w-10">
        <img class="h-full w-full rounded-full object-cover object-center" src={logoUrl} alt="" />
      </span>
      <span
        class="grid gap-0.5 font-serif text-[13px] leading-[0.95] font-bold tracking-[0.08em] uppercase max-sm:text-[10px]">
        <span>{t("main.logoLineOne")}</span>
        <span>{t("main.logoLineTwo")}</span>
        <span>{t("main.logoLineThree")}</span>
      </span>
    </a>

    <nav
      class="text-parchment flex items-center justify-center gap-10 text-[15px] leading-none max-xl:gap-6 max-lg:hidden"
      aria-label={t("nav.menu")}>
      {
        navItems.map((item) => (
          <a
            class={`hover:text-sacred-gold whitespace-nowrap underline-offset-8 transition hover:underline ${
              item.active ? "text-sacred-gold underline" : ""
            }`}
            href={item.href}
            aria-current={item.active ? "page" : undefined}>
            {t(item.key)}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center justify-end gap-5">
      <nav
        class="text-parchment/80 hidden items-center gap-2 font-sans text-xs sm:flex"
        aria-label={t("language.label")}>
        {
          languageItems.map((item, index) => (
            <>
              <a
                class={`inline-flex min-h-7 items-center rounded-sm px-2 font-bold transition ${
                  item.locale === lang ? "bg-gold text-ink" : "hover:text-white"
                }`}
                href={getLocalizedPath(path, item.locale)}
                aria-label={t(`language.${item.locale}`)}
                aria-current={item.locale === lang ? "page" : undefined}>
                {item.label}
              </a>
              {index < languageItems.length - 1 && <span aria-hidden="true">|</span>}
            </>
          ))
        }
      </nav>

      <label
        for="primary-menu-toggle"
        class="text-parchment hidden h-11 w-11 cursor-pointer list-none items-center justify-center rounded-sm border border-white/40 bg-white/10 transition marker:hidden hover:bg-white/20 max-lg:inline-flex [&::-webkit-details-marker]:hidden"
        aria-label={t("nav.openMenu")}
        aria-controls="primary-menu">
        <span class="sr-only">{t("nav.menu")}</span>
        <span class="relative block h-4 w-5" aria-hidden="true">
          <span class="burger-top absolute top-0 left-0 h-0.5 w-5 bg-current transition"></span>
          <span class="burger-middle absolute top-[7px] left-0 h-0.5 w-5 bg-current transition"></span>
          <span class="burger-bottom absolute top-3.5 left-0 h-0.5 w-5 bg-current transition"></span>
        </span>
      </label>
    </div>
  </div>

  <nav
    id="primary-menu"
    class="bg-church-green border-sacred-gold/70 hidden border-t peer-checked:block lg:hidden"
    aria-label={t("nav.menu")}>
    <div class="text-parchment mx-auto grid w-[calc(100%_-_32px)] gap-1 py-4 text-base">
      {
        navItems.map((item) => (
          <a
            class={`rounded-sm px-3 py-3 transition ${item.active ? "text-sacred-gold bg-white/10" : "hover:bg-white/10"}`}
            href={item.href}
            aria-current={item.active ? "page" : undefined}>
            {t(item.key)}
          </a>
        ))
      }
      <div class="text-parchment/80 mt-2 flex gap-3 border-t border-white/20 pt-4 font-sans text-sm sm:hidden">
        {
          languageItems.map((item) => (
            <a
              class={`inline-flex min-h-8 items-center rounded-sm px-2 font-bold transition ${
                item.locale === lang ? "bg-gold text-ink" : "hover:text-white"
              }`}
              href={getLocalizedPath(path, item.locale)}
              aria-label={t(`language.${item.locale}`)}
              aria-current={item.locale === lang ? "page" : undefined}>
              {item.label}
            </a>
          ))
        }
      </div>
    </div>
  </nav>
</header>
