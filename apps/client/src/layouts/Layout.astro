---
import Navbar from "@components/Navbar.astro";
import PomelnicModal from "@components/home/PomelnicModal.astro";
import { getLocaleFromUrl, useTranslations } from "@i18n/utils";
import { publicAsset } from "@utils/paths";

import "@styles/global.css";

const lang = getLocaleFromUrl(Astro.url);
const t = useTranslations(lang);
const faviconHref = publicAsset("/favicon.ico");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="darkreader-lock" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={t("main.description")} />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{t("main.title")}</title>
  </head>
  <body>
    <Navbar path={Astro.url.pathname} lang={lang} />
    <PomelnicModal lang={lang} />
    <slot />
  </body>
</html>
